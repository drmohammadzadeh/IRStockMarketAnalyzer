p"><span _ngcontent-dph-c3="" style="color: #055274;">۸,۸۵۲,۲۸۳ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-dph-c3="" style="color: #055274;">۴,۶۳۵,۳۰۸ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-dph-c3="" style="color: #055274;">۹۱ </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">هزینه های تولید </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۶,۰۱۴,۸۹۸) </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۳,۳۴۲,۸۸۸) </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۸۰) </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">هزینه های فروش، اداری و عمومی </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۳۳۴,۴۵۸) </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۲۱۸,۵۱۷) </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۵۳) </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">ساير درآمدهاى عملياتى </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">ساير هزينه ‏هاى عملياتى </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۲۰۶,۰۴۲) </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۱۶۹,۲۴۱) </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;" class="is-negative">(۲۲) </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">سود (زیان) عملیاتی </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-dph-c3="" style="color: #055274;">۲,۲۹۶,۸۸۵ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-dph-c3="" style="color: #055274;">۹۰۴,۶۶۲ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-dph-c3="" style="color: #055274;">۱۵۴ </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">سود (زیان) فروش دارایی زیستی مولد </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۶۱۶,۷۳۹ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۲۱۵,۲۱۴ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngconte