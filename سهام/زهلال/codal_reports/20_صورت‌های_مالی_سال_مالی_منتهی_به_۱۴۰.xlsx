<h3>
صورت سود و زیان
</h3>
<hr>
</div>
<br>
<!----><app-statement _ngcontent-dph-c0="" _nghost-dph-c1=""><div _ngcontent-dph-c1="" style="direction: rtl;"><!----><div _ngcontent-dph-c1=""><!----><div _ngcontent-dph-c1="" class="sheet-container"><app-sheet _ngcontent-dph-c1="" _nghost-dph-c2=""><!----><div _ngcontent-dph-c2="" class="table-containet"><!----><div _ngcontent-dph-c2="" class="table-title ng-binding ng-scope">صورت سود و زیان</div><!----><div _ngcontent-dph-c2="" class="table-description ng-binding ng-scope">کلیه مبالغ درج شده به میلیون ریال می باشد</div><app-table _ngcontent-dph-c2="" _nghost-dph-c3=""><table _ngcontent-dph-c3="" class="rayanDynamicStatement"><thead _ngcontent-dph-c3=""><!----><tr _ngcontent-dph-c3=""><!----><th _ngcontent-dph-c3="" rowspan="2" colspan="1"><span _ngcontent-dph-c3="">شرح</span></th><th _ngcontent-dph-c3="" rowspan="1" colspan="1"><span _ngcontent-dph-c3="">دوره منتهی به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-dph-c3="" rowspan="1" colspan="1"><span _ngcontent-dph-c3="">تجدید ارائه شده سال مالی منتهی به  ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-dph-c3="" rowspan="2" colspan="1"><span _ngcontent-dph-c3="">درصد تغییرات</span></th></tr><tr _ngcontent-dph-c3=""><!----><th _ngcontent-dph-c3="" rowspan="1" colspan="1"><span _ngcontent-dph-c3="">حسابرسی شده</span></th><th _ngcontent-dph-c3="" rowspan="1" colspan="1"><span _ngcontent-dph-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-dph-c3=""><!----><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">عملیات در حال تداوم: </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;"> </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;"> </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">ارزش منصفانه تولیدات کشاورزی </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۶,۶۴۷,۴۷۹ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۳,۹۵۰,۳۵۶ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۶۸ </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">خالص افزایش (کاهش) ارزش منصفانه دارایی های زیستی غیر مولد </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۱,۳۷۷,۳۱۱ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۴۹۰,۷۲۶ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-dph-c3="" style="color: #055274;">۱۸۱ </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-dph-c3="" style="color: #055274;">مجموع </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-dph-c3="" style="color: #055274;">۸,۰۲۴,۷۹۰ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-dph-c3="" style="color: #055274;">۴,۴۴۱,۰۸۲ </span></td><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-dph-c3="" style="color: #055274;">۸۱ </span></td></tr><tr _ngcontent-dph-c3=""><!----><td _ngcontent-dph-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-dph-c