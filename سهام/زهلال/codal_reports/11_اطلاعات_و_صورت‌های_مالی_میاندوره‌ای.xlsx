<h3>
صورت سود و زیان
</h3>
<hr>
</div>
<br>
<!----><app-statement _ngcontent-eho-c0="" _nghost-eho-c1=""><div _ngcontent-eho-c1="" style="direction: rtl;"><!----><div _ngcontent-eho-c1=""><!----><div _ngcontent-eho-c1="" class="sheet-container"><app-sheet _ngcontent-eho-c1="" _nghost-eho-c2=""><!----><div _ngcontent-eho-c2="" class="table-containet"><!----><div _ngcontent-eho-c2="" class="table-title ng-binding ng-scope">صورت سود و زیان</div><!----><div _ngcontent-eho-c2="" class="table-description ng-binding ng-scope">کلیه مبالغ درج شده به میلیون ریال می باشد</div><app-table _ngcontent-eho-c2="" _nghost-eho-c3=""><table _ngcontent-eho-c3="" class="rayanDynamicStatement"><thead _ngcontent-eho-c3=""><!----><tr _ngcontent-eho-c3=""><!----><th _ngcontent-eho-c3="" rowspan="2" colspan="1"><span _ngcontent-eho-c3="">شرح</span></th><th _ngcontent-eho-c3="" rowspan="1" colspan="1"><span _ngcontent-eho-c3="">دوره منتهی به ۱۴۰۵/۰۳/۳۱</span></th><th _ngcontent-eho-c3="" rowspan="1" colspan="1"><span _ngcontent-eho-c3="">تجدید ارائه شده دوره مالی منتهی به ۱۴۰۴/۰۳/۳۱</span></th><th _ngcontent-eho-c3="" rowspan="1" colspan="1"><span _ngcontent-eho-c3="">تجدید ارائه شده سال مالی منتهی به  ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-eho-c3="" rowspan="2" colspan="1"><span _ngcontent-eho-c3="">درصد تغییرات</span></th></tr><tr _ngcontent-eho-c3=""><!----><th _ngcontent-eho-c3="" rowspan="1" colspan="1"><span _ngcontent-eho-c3="">حسابرسی نشده</span></th><th _ngcontent-eho-c3="" rowspan="1" colspan="1"><span _ngcontent-eho-c3="">حسابرسی نشده</span></th><th _ngcontent-eho-c3="" rowspan="1" colspan="1"><span _ngcontent-eho-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-eho-c3=""><!----><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">عملیات در حال تداوم: </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;"> </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;"> </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;"> </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">ارزش منصفانه تولیدات کشاورزی </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۲,۵۹۱,۵۲۵ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۱,۱۳۴,۲۲۲ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۶,۶۴۷,۴۷۹ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۱۲۸ </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">خالص افزایش (کاهش) ارزش منصفانه دارایی های زیستی غیر مولد </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۴۶۵,۳۷۲ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۱۰۵,۳۰۲ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۱,۳۷۷,۳۱۱ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۳۴۲ </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">مجموع </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۳,۰۵۶,۸۹۷ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۱,۲۳۹,۵۲۴ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۸,۰۲۴,۷۹۰ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۱۴۷ </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">خالص فروش تولیدات کشاورزی و دارایی های زیستی غیر مولد </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۳,۱۸۱,۵۶۶ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۱,۲۰۸,۴۴۱ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۷,۴۳۹,۸۵۰ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۱۶۳ </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">بهای تمام شده انتسابی </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۲,۹۰۱,۷۳۵) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۱,۱۴۲,۰۹۶) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۶,۶۱۲,۳۵۷) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۱۵۴) </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">مجموع </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۲۷۹,۸۳۱ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۶۶,۳۴۵ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۸۲۷,۴۹۳ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۳۲۲ </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">درآمدهای عملیاتی </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۳,۳۳۶,۷۲۸ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۱,۳۰۵,۸۶۹ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۸,۸۵۲,۲۸۳ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۱۵۶ </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">هزینه های تولید </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۲,۸۷۵,۲۰۵) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۹۹۰,۷۹۹) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۶,۰۱۴,۸۹۸) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۱۹۰) </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">هزینه های فروش، اداری و عمومی </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۱۲۱,۱۵۷) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۶۱,۸۲۱) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۳۳۴,۴۵۸) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۹۶) </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">ساير درآمدهاى عملياتى </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">ساير هزينه ‏هاى عملياتى </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۶۵,۴۰۸) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۳۷,۶۸۶) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۲۰۶,۰۴۲) </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;" class="is-negative">(۷۴) </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">سود (زیان) عملیاتی </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۲۷۴,۹۵۸ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۲۱۵,۵۶۳ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۲,۲۹۶,۸۸۵ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-eho-c3="" style="color: #055274;">۲۸ </span></td></tr><tr _ngcontent-eho-c3=""><!----><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-eho-c3="" style="color: #055274;">سود (زیان) فروش دارایی زیستی مولد </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۱۸۱,۴۲۹ </span></td><td _ngcontent-eho-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-eho-c3="" style="color: #055274;">۴۱,۳۱۱ </span></td><td