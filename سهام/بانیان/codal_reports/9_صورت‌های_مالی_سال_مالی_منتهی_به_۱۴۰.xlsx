<!----><app-statement _ngcontent-fhn-c0="" _nghost-fhn-c1=""><div _ngcontent-fhn-c1="" style="direction: rtl;"><!----><div _ngcontent-fhn-c1=""><!----><div _ngcontent-fhn-c1="" class="sheet-container"><app-sheet _ngcontent-fhn-c1="" _nghost-fhn-c2=""><!----><div _ngcontent-fhn-c2="" class="table-containet"><!----><div _ngcontent-fhn-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان</div><!----><div _ngcontent-fhn-c2="" class="table-description ng-binding ng-scope">کليه مبالغ به ميليون ريال است</div><app-table _ngcontent-fhn-c2="" _nghost-fhn-c3=""><table _ngcontent-fhn-c3="" class="rayanDynamicStatement"><thead _ngcontent-fhn-c3=""><!----><tr _ngcontent-fhn-c3=""><!----><th _ngcontent-fhn-c3="" rowspan="2" colspan="1"><span _ngcontent-fhn-c3="">شرح</span></th><th _ngcontent-fhn-c3="" rowspan="1" colspan="1"><span _ngcontent-fhn-c3="">دوره منتهي به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-fhn-c3="" rowspan="1" colspan="1"><span _ngcontent-fhn-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-fhn-c3="" rowspan="2" colspan="1"><span _ngcontent-fhn-c3="">درصد تغيير</span></th></tr><tr _ngcontent-fhn-c3=""><!----><th _ngcontent-fhn-c3="" rowspan="1" colspan="1"><span _ngcontent-fhn-c3="">حسابرسی شده</span></th><th _ngcontent-fhn-c3="" rowspan="1" colspan="1"><span _ngcontent-fhn-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-fhn-c3=""><!----><tr _ngcontent-fhn-c3=""><!----><td _ngcontent-fhn-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-fhn-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-fhn-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-fhn-c3="" style="color: #055274;"> </span></td><td _ngcontent-fhn-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-fhn-c3="" style="color: #055274;"> </span></td><td _ngcontent-fhn-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-fhn-