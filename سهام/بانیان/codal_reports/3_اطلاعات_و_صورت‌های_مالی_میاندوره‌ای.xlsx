3="" style="color: #055274;">۰ </span></td><td _ngcontent-rnv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rnv-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-rnv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rnv-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-rnv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rnv-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-rnv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rnv-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-rnv-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rnv-c3="" style="color: #055274;">۰ </span></td></tr></tbody></table></app-table></div><div _ngcontent-rnv-c2="" class="table-containet"><!----><div _ngcontent-rnv-c2="" class="table-title ng-binding ng-scope">توضیحات در خصوص وضعیت شرکت‌های سرمایه‌پذیر</div><!----><app-table _ngcontent-rnv-c2="" _nghost-rnv-c3=""><table _ngcontent-rnv-c3="" class="rayanDynamicStatement"><thead _ngcontent-rnv-c3=""><!----></thead><tbody _ngcontent-rnv-c3=""><!----><tr _ngcontent-rnv-c3=""><!----><td _ngcontent-rnv-c3="" rowspan="1" colspan="20" class="right-aligne"><span _ngcontent-rnv-c3="" style="color: #055274;">۵ درصد از سهام شرکت سهامی خاص صندوق پژوهش و فناوری غیردولتی سرمایه گذاری خطر پذیر شرکتی صنایع الکترونیک نیان متعلق به شرکت نیان باتری خاوران می باشد. </span></td></tr></tbody></table></app-table></div><div _ngcontent-rnv-c2="" class="table-containet"><!----><!----><app-table _ngcontent-rnv-c2="" _nghost-rnv-c3=""><table _ngcontent-rnv-c3="" class="rayanDynamicStatement"><thead _ngcontent-rnv-c3=""><!----></thead><tbody _ngcontent-rnv-c3=""><!----><tr _ngcontent-rnv-c3=""><!----><td _ngcontent-rnv-c3="" rowspan="1" colspan="20" class="right-aligne"><span _ngcontent-rnv-c3="" style="color: #055274;">«جملات آینده‌نگر نشان‌دهنده انتظارات، باورها یا پیش‌بینی‌های جاری از رویدادها و عملکرد مالی است. این جملات در معرض ریسک‌ها، عدم ‌قطعیت‌ها و مفروضات غیرقطعی قرار دارند. بنابراین نتایج واقعی ممکن است متفاوت از نتایج مورد انتظار باشند.» </span></td></tr></tbody></table></app-table></div></app-sheet></div></div></div></app-statement>
</div>
