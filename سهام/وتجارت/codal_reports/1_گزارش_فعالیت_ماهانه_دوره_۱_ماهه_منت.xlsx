<!----><app-statement _ngcontent-rkh-c0="" _nghost-rkh-c1=""><div _ngcontent-rkh-c1="" style="direction: rtl;"><!----><div _ngcontent-rkh-c1=""><!----><div _ngcontent-rkh-c1="" class="sheet-container"><app-sheet _ngcontent-rkh-c1="" _nghost-rkh-c2=""><!----><div _ngcontent-rkh-c2="" class="table-containet"><!----><div _ngcontent-rkh-c2="" class="table-title ng-binding ng-scope">درآمدهای عملیاتی محقق شده</div><!----><div _ngcontent-rkh-c2="" class="table-description ng-binding ng-scope">کلیه مبالغ به میلیون ریال است</div><app-table _ngcontent-rkh-c2="" _nghost-rkh-c3=""><table _ngcontent-rkh-c3="" class="rayanDynamicStatement"><thead _ngcontent-rkh-c3=""><!----><tr _ngcontent-rkh-c3=""><!----><th _ngcontent-rkh-c3="" rowspan="1" colspan="1"><span _ngcontent-rkh-c3="">شرح</span></th><th _ngcontent-rkh-c3="" rowspan="1" colspan="1"><span _ngcontent-rkh-c3="">درآمد محقق شده از ابتدای سال مالی تا پایان  ۱۴۰۵/۰۴/۳۱</span></th><th _ngcontent-rkh-c3="" rowspan="1" colspan="1"><span _ngcontent-rkh-c3="">اصلاحات</span></th><th _ngcontent-rkh-c3="" rowspan="1" colspan="1"><span _ngcontent-rkh-c3="">درآمد محقق شده از ابتدای سال مالی تا پایان  ۱۴۰۵/۰۴/۳۱ -اصلاح شده</span></th><th _ngcontent-rkh-c3="" rowspan="1" colspan="1"><span _ngcontent-rkh-c3="">درآمد محقق شده طی دوره یک ماهه منتهی به ۱۴۰۵/۰۵/۳۱</span></th><th _ngcontent-rkh-c3="" rowspan="1" colspan="1"><span _ngcontent-rkh-c3="">جمع درآمد محقق شده از ابتدای سال مالی تا پایان  ۱۴۰۵/۰۵/۳۱</span></th></tr></thead><tbody _ngcontent-rkh-c3=""><!----><tr _ngcontent-rkh-c3=""><!----><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-rkh-c3="" style="color: #055274;">درآمد تسهیلات اعطایی </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۴۶۸,۱۷۶,۲۴۲ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-rkh-c3="" style="color: #055274;">۴۶۸,۱۷۶,۲۴۲ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۱۱۳,۳۹۳,۳۶۵ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-rkh-c3="" style="color: #055274;">۵۸۱,۵۶۹,۶۰۷ </span></td></tr><tr _ngcontent-rkh-c3=""><!----><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-rkh-c3="" style="color: #055274;">درآمد سپرده گذاری </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۳۱,۲۵۴,۱۸۱ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-rkh-c3="" style="color: #055274;">۳۱,۲۵۴,۱۸۱ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۷,۷۶۳,۵۷۶ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-rkh-c3="" style="color: #055274;">۳۹,۰۱۷,۷۵۷ </span></td></tr><tr _ngcontent-rkh-c3=""><!----><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-rkh-c3="" style="color: #055274;">درآمد اوراق بدهی </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۳۱,۰۹۵,۶۹۳ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-rkh-c3="" style="color: #055274;">۳۱,۰۹۵,۶۹۳ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rkh-c3="" style="color: #055274;">۸,۸۵۸,۹۲۰ </span></td><td _ngcontent-rkh-c3="" rowspan="1" colsp