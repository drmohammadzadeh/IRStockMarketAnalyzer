<!----><app-statement _ngcontent-jlg-c0="" _nghost-jlg-c1=""><div _ngcontent-jlg-c1="" style="direction: rtl;"><!----><div _ngcontent-jlg-c1=""><!----><div _ngcontent-jlg-c1="" class="sheet-container"><app-sheet _ngcontent-jlg-c1="" _nghost-jlg-c2=""><!----><div _ngcontent-jlg-c2="" class="table-containet"><!----><div _ngcontent-jlg-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان</div><!----><div _ngcontent-jlg-c2="" class="table-description ng-binding ng-scope">کليه مبالغ به ميليون ريال است</div><app-table _ngcontent-jlg-c2="" _nghost-jlg-c3=""><table _ngcontent-jlg-c3="" class="rayanDynamicStatement"><thead _ngcontent-jlg-c3=""><!----><tr _ngcontent-jlg-c3=""><!----><th _ngcontent-jlg-c3="" rowspan="2" colspan="1"><span _ngcontent-jlg-c3="">شرح</span></th><th _ngcontent-jlg-c3="" rowspan="1" colspan="1"><span _ngcontent-jlg-c3="">دوره منتهي به ۱۴۰۵/۰۳/۳۱</span></th><th _ngcontent-jlg-c3="" rowspan="1" colspan="1"><span _ngcontent-jlg-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۴/۰۳/۳۱</span></th><th _ngcontent-jlg-c3="" rowspan="1" colspan="1"><span _ngcontent-jlg-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۴/۰۹/۳۰</span></th><th _ngcontent-jlg-c3="" rowspan="2" colspan="1"><span _ngcontent-jlg-c3="">درصد تغيير</span></th></tr><tr _ngcontent-jlg-c3=""><!----><th _ngcontent-jlg-c3="" rowspan="1" colspan="1"><span _ngcontent-jlg-c3="">حسابرسی شده</span></th><th _ngcontent-jlg-c3="" rowspan="1" colspan="1"><span _ngcontent-jlg-c3="">حسابرسی شده</span></th><th _ngcontent-jlg-c3="" rowspan="1" colspan="1"><span _ngcontent-jlg-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-jlg-c3=""><!----><tr _ngcontent-jlg-c3=""><!----><td _ngcontent-jlg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jlg-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-jlg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jlg-c3="" style="color: #055274;"> </span></td><td _ngcontent-jlg-c3=""