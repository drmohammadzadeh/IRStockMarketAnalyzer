an="1" class="dynamic_comp"><span _ngcontent-clg-c3="" style="color: #055274;">۳۱,۰۹۵,۶۹۳ </span></td></tr><tr _ngcontent-clg-c3=""><!----><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-clg-c3="" style="color: #055274;">درآمد سرمایه گذاری ها </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-clg-c3="" style="color: #055274;">۲,۱۴۷,۰۹۷ </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-clg-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-clg-c3="" style="color: #055274;">۲,۱۴۷,۰۹۷ </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-clg-c3="" style="color: #055274;">۵۳۷,۰۰۶ </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-clg-c3="" style="color: #055274;">۲,۶۸۴,۱۰۳ </span></td></tr><tr _ngcontent-clg-c3=""><!----><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-clg-c3="" style="color: #055274;">درامد کارمزد </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-clg-c3="" style="color: #055274;">۱۳۹,۹۱۹,۸۵۰ </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-clg-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-clg-c3="" style="color: #055274;">۱۳۹,۹۱۹,۸۵۰ </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-clg-c3="" style="color: #055274;">۳۷,۱۲۲,۸۸۰ </span></td><td _ngcontent-clg-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-clg-c3="" style="color: #055274;">۱۷۷,۰۴۲,۷۳۰ </span></td></tr><tr _ngcontent-clg-c3=""><!----><td _ngcontent-clg-c3="" rowspan="1" colspan="6" class="right-aligne"><span _ngcontent-clg-c3="" style="color: #055274;">سرفصل های مندرج در