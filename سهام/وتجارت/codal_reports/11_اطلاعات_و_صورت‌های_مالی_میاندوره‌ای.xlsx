<!----><app-statement _ngcontent-ofl-c0="" _nghost-ofl-c1=""><div _ngcontent-ofl-c1="" style="direction: rtl;"><!----><div _ngcontent-ofl-c1=""><!----><div _ngcontent-ofl-c1="" class="sheet-container"><app-sheet _ngcontent-ofl-c1="" _nghost-ofl-c2=""><!----><div _ngcontent-ofl-c2="" class="table-containet"><!----><div _ngcontent-ofl-c2="" class="table-title ng-binding ng-scope">صورت سود و زیان</div><!----><div _ngcontent-ofl-c2="" class="table-description ng-binding ng-scope">کلیه مبالغ به میلیون ريال است</div><app-table _ngcontent-ofl-c2="" _nghost-ofl-c3=""><table _ngcontent-ofl-c3="" class="rayanDynamicStatement"><thead _ngcontent-ofl-c3=""><!----><tr _ngcontent-ofl-c3=""><!----><th _ngcontent-ofl-c3="" rowspan="2" colspan="1"><span _ngcontent-ofl-c3="">شرح</span></th><th _ngcontent-ofl-c3="" rowspan="1" colspan="1"><span _ngcontent-ofl-c3="">دوره منتهي به ۱۴۰۵/۰۳/۳۱</span></th><th _ngcontent-ofl-c3="" rowspan="1" colspan="1"><span _ngcontent-ofl-c3="">تجدید ارائه شده دوره منتهی به ۱۴۰۴/۰۳/۳۱</span></th><th _ngcontent-ofl-c3="" rowspan="1" colspan="1"><span _ngcontent-ofl-c3="">تجدید ارائه شده دوره منتهی به ۱۴۰۴/۰۹/۳۰</span></th><th _ngcontent-ofl-c3="" rowspan="2" colspan="1"><span _ngcontent-ofl-c3="">درصد تغییر</span></th></tr><tr _ngcontent-ofl-c3=""><!----><th _ngcontent-ofl-c3="" rowspan="1" colspan="1"><span _ngcontent-ofl-c3="">حسابرسی شده</span></th><th _ngcontent-ofl-c3="" rowspan="1" colspan="1"><span _ngcontent-ofl-c3="">حسابرسی شده</span></th><th _ngcontent-ofl-c3="" rowspan="1" colspan="1"><span _ngcontent-ofl-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-ofl-c3=""><!----><tr _ngcontent-ofl-c3=""><!----><td _ngcontent-ofl-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-ofl-c3="" style="color: #055274;">عملیات در حال تداوم: </span></td><td _ngcontent-ofl-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-ofl-c3="" style="color: #055274;"> </span></td><td _ngcontent-ofl-c3=""