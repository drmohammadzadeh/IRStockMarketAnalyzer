<h3>
صورت سود و زیان
</h3>
<hr>
</div>
<br>
<!----><app-statement _ngcontent-aee-c0="" _nghost-aee-c1=""><div _ngcontent-aee-c1="" style="direction: rtl;"><!----><div _ngcontent-aee-c1=""><!----><div _ngcontent-aee-c1="" class="sheet-container"><app-sheet _ngcontent-aee-c1="" _nghost-aee-c2=""><!----><div _ngcontent-aee-c2="" class="table-containet"><!----><div _ngcontent-aee-c2="" class="table-title ng-binding ng-scope">صورت سود و زیان</div><!----><div _ngcontent-aee-c2="" class="table-description ng-binding ng-scope">کلیه مبالغ درج شده به میلیون ریال می باشد</div><app-table _ngcontent-aee-c2="" _nghost-aee-c3=""><table _ngcontent-aee-c3="" class="rayanDynamicStatement"><thead _ngcontent-aee-c3=""><!----><tr _ngcontent-aee-c3=""><!----><th _ngcontent-aee-c3="" rowspan="2" colspan="1"><span _ngcontent-aee-c3="">شرح</span></th><th _ngcontent-aee-c3="" rowspan="1" colspan="1"><span _ngcontent-aee-c3="">دوره منتهی به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-aee-c3="" rowspan="1" colspan="1"><span _ngcontent-aee-c3="">تجدید ارائه شده سال مالی منتهی به  ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-aee-c3="" rowspan="2" colspan="1"><span _ngcontent-aee-c3="">درصد تغییرات</span></th></tr><tr _ngcontent-aee-c3=""><!----><th _ngcontent-aee-c3="" rowspan="1" colspan="1"><span _ngcontent-aee-c3="">حسابرسی شده</span></th><th _ngcontent-aee-c3="" rowspan="1" colspan="1"><span _ngcontent-aee-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-aee-c3=""><!----><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">عملیات در حال تداوم: </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;"> </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;"> </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">ارزش منصفانه تولیدات کشاورزی </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۱۴,۶۹۷,۹۹۰ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۹,۵۷۳,۱۱۲ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۵۴ </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">خالص افزایش (کاهش) ارزش منصفانه دارایی های زیستی غیر مولد </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۳۱۳,۰۸۱ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۱۹۴,۴۱۲ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۶۱ </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">مجموع </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۱۵,۰۱۱,۰۷۱ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۹,۷۶۷,۵۲۴ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۵۴ </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">خالص فروش تولیدات کشاورزی و دارایی های زیستی غیر مولد </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۱۷,۶۹۱,۸۹۴ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۱۰,۳۲۸,۵۱۵ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۷۱ </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">بهای تمام شده انتسابی </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۱۴,۳۲۴,۵۱۱) </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۹,۲۳۹,۵۴۲) </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۵۵) </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">مجموع </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۳,۳۶۷,۳۸۳ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۱,۰۸۸,۹۷۳ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۲۰۹ </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">درآمدهای عملیاتی </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۱۸,۳۷۸,۴۵۴ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۱۰,۸۵۶,۴۹۷ </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-aee-c3="" style="color: #055274;">۶۹ </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">هزینه های تولید </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۱۳,۴۰۷,۲۰۵) </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۸,۷۰۲,۶۳۸) </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۵۴) </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">هزینه های فروش، اداری و عمومی </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۳۵۸,۴۲۵) </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۲۰۶,۲۴۵) </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;" class="is-negative">(۷۴) </span></td></tr><tr _ngcontent-aee-c3=""><!----><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-aee-c3="" style="color: #055274;">ساير درآمدهاى عملياتى </span></td><td _ngcontent-aee-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-aee-c3="" style="color: #055274;">۶۷۷ </span></td><td _ngcontent-aee-c3="" rowspan=