<!----><app-statement _ngcontent-foj-c0="" _nghost-foj-c1=""><div _ngcontent-foj-c1="" style="direction: rtl;"><!----><div _ngcontent-foj-c1=""><!----><div _ngcontent-foj-c1="" class="sheet-container"><app-sheet _ngcontent-foj-c1="" _nghost-foj-c2=""><!----><div _ngcontent-foj-c2="" class="table-containet"><!----><div _ngcontent-foj-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان</div><!----><div _ngcontent-foj-c2="" class="table-description ng-binding ng-scope">کليه مبالغ به ميليون ريال است</div><app-table _ngcontent-foj-c2="" _nghost-foj-c3=""><table _ngcontent-foj-c3="" class="rayanDynamicStatement"><thead _ngcontent-foj-c3=""><!----><tr _ngcontent-foj-c3=""><!----><th _ngcontent-foj-c3="" rowspan="2" colspan="1"><span _ngcontent-foj-c3="">شرح</span></th><th _ngcontent-foj-c3="" rowspan="1" colspan="1"><span _ngcontent-foj-c3="">دوره منتهي به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-foj-c3="" rowspan="1" colspan="1"><span _ngcontent-foj-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-foj-c3="" rowspan="2" colspan="1"><span _ngcontent-foj-c3="">درصد تغيير</span></th></tr><tr _ngcontent-foj-c3=""><!----><th _ngcontent-foj-c3="" rowspan="1" colspan="1"><span _ngcontent-foj-c3="">حسابرسی شده</span></th><th _ngcontent-foj-c3="" rowspan="1" colspan="1"><span _ngcontent-foj-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-foj-c3=""><!----><tr _ngcontent-foj-c3=""><!----><td _ngcontent-foj-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-foj-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-foj-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-foj-c3="" style="color: #055274;"> </span></td><td _ngcontent-foj-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-foj-c3="" style="color: #055274;"> </span></td><td _ngcontent-foj-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-foj-