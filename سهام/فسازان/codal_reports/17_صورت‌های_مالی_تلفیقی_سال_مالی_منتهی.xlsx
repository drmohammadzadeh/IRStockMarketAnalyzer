<!----><app-statement _ngcontent-ydg-c0="" _nghost-ydg-c1=""><div _ngcontent-ydg-c1="" style="direction: rtl;"><!----><div _ngcontent-ydg-c1=""><!----><div _ngcontent-ydg-c1="" class="sheet-container"><app-sheet _ngcontent-ydg-c1="" _nghost-ydg-c2=""><!----><div _ngcontent-ydg-c2="" class="table-containet"><!----><div _ngcontent-ydg-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان تلفيقي</div><!----><app-table _ngcontent-ydg-c2="" _nghost-ydg-c3=""><table _ngcontent-ydg-c3="" class="rayanDynamicStatement"><thead _ngcontent-ydg-c3=""><!----><tr _ngcontent-ydg-c3=""><!----><th _ngcontent-ydg-c3="" rowspan="2" colspan="1"><span _ngcontent-ydg-c3="">شرح</span></th><th _ngcontent-ydg-c3="" rowspan="1" colspan="1"><span _ngcontent-ydg-c3="">دوره منتهي به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-ydg-c3="" rowspan="1" colspan="1"><span _ngcontent-ydg-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-ydg-c3="" rowspan="2" colspan="1"><span _ngcontent-ydg-c3="">درصد تغيير</span></th></tr><tr _ngcontent-ydg-c3=""><!----><th _ngcontent-ydg-c3="" rowspan="1" colspan="1"><span _ngcontent-ydg-c3="">حسابرسی شده</span></th><th _ngcontent-ydg-c3="" rowspan="1" colspan="1"><span _ngcontent-ydg-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-ydg-c3=""><!----><tr _ngcontent-ydg-c3=""><!----><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-ydg-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-ydg-c3="" style="color: #055274;"> </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-ydg-c3="" style="color: #055274;"> </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-ydg-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-ydg-c3=""><!----><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-ydg-c3="" style="color: #055274;">درآمدهاي عملياتي </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-ydg-c3="" style="color: #055274;">۱۱۱,۰۲۱,۴۶۲ </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-ydg-c3="" style="color: #055274;">۶۷,۶۷۰,۸۲۱ </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-ydg-c3="" style="color: #055274;">۶۴ </span></td></tr><tr _ngcontent-ydg-c3=""><!----><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-ydg-c3="" style="color: #055274;">بهاى تمام شده درآمدهاي عملياتي </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-ydg-c3="" style="color: #055274;" class="is-negative">(۹۱,۹۸۶,۰۴۷) </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-ydg-c3="" style="color: #055274;" class="is-negative">(۶۲,۲۶۸,۲۲۵) </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-ydg-c3="" style="color: #055274;" class="is-negative">(۴۸) </span></td></tr><tr _ngcontent-ydg-c3=""><!----><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-ydg-c3="" style="color: #055274;">سود(زيان) ناخالص </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-ydg-c3="" style="color: #055274;">۱۹,۰۳۵,۴۱۵ </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-ydg-c3="" style="color: #055274;">۵,۴۰۲,۵۹۶ </span></td><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-ydg-c3="" style="color: #055274;">۲۵۲ </span></td></tr><tr _ngcontent-ydg-c3=""><!----><td _ngcontent-ydg-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-ydg-c3="" style="color: #055274;">هزينه ‏هاى فروش، ادارى و عمومى </span></td><