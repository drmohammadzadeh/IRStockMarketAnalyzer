<!----><app-statement _ngcontent-rrf-c0="" _nghost-rrf-c1=""><div _ngcontent-rrf-c1="" style="direction: rtl;"><!----><div _ngcontent-rrf-c1=""><!----><div _ngcontent-rrf-c1="" class="sheet-container"><app-sheet _ngcontent-rrf-c1="" _nghost-rrf-c2=""><!----><div _ngcontent-rrf-c2="" class="table-containet"><!----><div _ngcontent-rrf-c2="" class="table-title ng-binding ng-scope">صورت جريان‌هاي نقدي</div><!----><div _ngcontent-rrf-c2="" class="table-description ng-binding ng-scope">کليه مبالغ به ميليون ريال است</div><app-table _ngcontent-rrf-c2="" _nghost-rrf-c3=""><table _ngcontent-rrf-c3="" class="rayanDynamicStatement"><thead _ngcontent-rrf-c3=""><!----><tr _ngcontent-rrf-c3=""><!----><th _ngcontent-rrf-c3="" rowspan="2" colspan="1"><span _ngcontent-rrf-c3="">شرح</span></th><th _ngcontent-rrf-c3="" rowspan="1" colspan="1"><span _ngcontent-rrf-c3="">دوره منتهي به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-rrf-c3="" rowspan="1" colspan="1"><span _ngcontent-rrf-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-rrf-c3="" rowspan="2" colspan="1"><span _ngcontent-rrf-c3="">درصد تغيير</span></th></tr><tr _ngcontent-rrf-c3=""><!----><th _ngcontent-rrf-c3="" rowspan="1" colspan="1"><span _ngcontent-rrf-c3="">حسابرسی شده</span></th><th _ngcontent-rrf-c3="" rowspan="1" colspan="1"><span _ngcontent-rrf-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-rrf-c3=""><!----><tr _ngcontent-rrf-c3=""><!----><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-rrf-c3="" style="color: #055274;">جريان­هاي نقدي حاصل از فعاليت‌هاي عملياتي: </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-rrf-c3="" style="color: #055274;"> </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-rrf-c3="" style="color: #055274;"> </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-rrf-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-rrf-c3=""><!----><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-rrf-c3="" style="color: #055274;">نقد حاصل از عمليات </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rrf-c3="" style="color: #055274;">۳,۴۰۶,۰۴۶ </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rrf-c3="" style="color: #055274;">۱,۵۱۶,۴۱۳ </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rrf-c3="" style="color: #055274;">۱۲۵ </span></td></tr><tr _ngcontent-rrf-c3=""><!----><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-rrf-c3="" style="color: #055274;">پرداخت‌هاي نقدي بابت ماليات بر درآمد </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rrf-c3="" style="color: #055274;" class="is-negative">(۴۰۲,۴۵۱) </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rrf-c3="" style="color: #055274;" class="is-negative">(۲۸۹,۹۵۹) </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-rrf-c3="" style="color: #055274;" class="is-negative">(۳۹) </span></td></tr><tr _ngcontent-rrf-c3=""><!----><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-rrf-c3="" style="color: #055274;">جريان ‌خالص ‌ورود‌ (خروج) ‌نقد حاصل از فعاليت‌هاي ‌عملياتي </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-rrf-c3="" style="color: #055274;">۳,۰۰۳,۵۹۵ </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-rrf-c3="" style="color: #055274;">۱,۲۲۶,۴۵۴ </span></td><td _ngcontent-rrf-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-rrf-c3="" style="color: #055274;">۱۴۵ </span></td></tr><tr _ngcontent-rrf-c3=""><!---