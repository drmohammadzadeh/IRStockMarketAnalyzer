<!----><app-statement _ngcontent-jma-c0="" _nghost-jma-c1=""><div _ngcontent-jma-c1="" style="direction: rtl;"><!----><div _ngcontent-jma-c1=""><!----><div _ngcontent-jma-c1="" class="sheet-container"><app-sheet _ngcontent-jma-c1="" _nghost-jma-c2=""><!----><div _ngcontent-jma-c2="" class="table-containet"><!----><div _ngcontent-jma-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان</div><!----><div _ngcontent-jma-c2="" class="table-description ng-binding ng-scope">کليه مبالغ به ميليون ريال است</div><app-table _ngcontent-jma-c2="" _nghost-jma-c3=""><table _ngcontent-jma-c3="" class="rayanDynamicStatement"><thead _ngcontent-jma-c3=""><!----><tr _ngcontent-jma-c3=""><!----><th _ngcontent-jma-c3="" rowspan="2" colspan="1"><span _ngcontent-jma-c3="">شرح</span></th><th _ngcontent-jma-c3="" rowspan="1" colspan="1"><span _ngcontent-jma-c3="">دوره منتهي به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-jma-c3="" rowspan="1" colspan="1"><span _ngcontent-jma-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-jma-c3="" rowspan="2" colspan="1"><span _ngcontent-jma-c3="">درصد تغيير</span></th></tr><tr _ngcontent-jma-c3=""><!----><th _ngcontent-jma-c3="" rowspan="1" colspan="1"><span _ngcontent-jma-c3="">حسابرسی شده</span></th><th _ngcontent-jma-c3="" rowspan="1" colspan="1"><span _ngcontent-jma-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-jma-c3=""><!----><tr _ngcontent-jma-c3=""><!----><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jma-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jma-c3="" style="color: #055274;"> </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jma-c3="" style="color: #055274;"> </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jma-c3="" style="color: #055274;"> </span></td></tr><tr _ngcontent-jma-c3=""><!----><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-jma-c3="" style="color: #055274;">درآمدهاي عملياتي </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-jma-c3="" style="color: #055274;">۳,۸۲۶,۰۹۶,۷۷۴ </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-jma-c3="" style="color: #055274;">۲,۵۵۷,۸۵۵,۱۷۹ </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-jma-c3="" style="color: #055274;">۵۰ </span></td></tr><tr _ngcontent-jma-c3=""><!----><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-jma-c3="" style="color: #055274;">بهاى تمام شده درآمدهاي عملياتي </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-jma-c3="" style="color: #055274;" class="is-negative">(۳,۷۴۴,۱۷۳,۶۶۲) </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-jma-c3="" style="color: #055274;" class="is-negative">(۲,۴۳۷,۴۶۹,۱۵۷) </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-jma-c3="" style="color: #055274;" class="is-negative">(۵۴) </span></td></tr><tr _ngcontent-jma-c3=""><!----><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-jma-c3="" style="color: #055274;">سود(زيان) ناخالص </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-jma-c3="" style="color: #055274;">۸۱,۹۲۳,۱۱۲ </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-jma-c3="" style="color: #055274;">۱۲۰,۳۸۶,۰۲۲ </span></td><td _ngcontent-jma-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-jma-c3="" style="color: #055274;" class="is-negative">(۳۲) </span></td></tr><tr _ngcontent-jma-c3=""><!----><td _ngcontent-jma-c3="" rowspa