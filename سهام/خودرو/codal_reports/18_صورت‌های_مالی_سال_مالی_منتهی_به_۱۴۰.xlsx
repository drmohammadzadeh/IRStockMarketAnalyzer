<!----><app-statement _ngcontent-yov-c0="" _nghost-yov-c1=""><div _ngcontent-yov-c1="" style="direction: rtl;"><!----><div _ngcontent-yov-c1=""><!----><div _ngcontent-yov-c1="" class="sheet-container"><app-sheet _ngcontent-yov-c1="" _nghost-yov-c2=""><!----><div _ngcontent-yov-c2="" class="table-containet"><!----><div _ngcontent-yov-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان</div><!----><div _ngcontent-yov-c2="" class="table-description ng-binding ng-scope">کليه مبالغ به ميليون ريال است</div><app-table _ngcontent-yov-c2="" _nghost-yov-c3=""><table _ngcontent-yov-c3="" class="rayanDynamicStatement"><thead _ngcontent-yov-c3=""><!----><tr _ngcontent-yov-c3=""><!----><th _ngcontent-yov-c3="" rowspan="2" colspan="1"><span _ngcontent-yov-c3="">شرح</span></th><th _ngcontent-yov-c3="" rowspan="1" colspan="1"><span _ngcontent-yov-c3="">دوره منتهي به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-yov-c3="" rowspan="1" colspan="1"><span _ngcontent-yov-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-yov-c3="" rowspan="2" colspan="1"><span _ngcontent-yov-c3="">درصد تغيير</span></th></tr><tr _ngcontent-yov-c3=""><!----><th _ngcontent-yov-c3="" rowspan="1" colspan="1"><span _ngcontent-yov-c3="">حسابرسی شده</span></th><th _ngcontent-yov-c3="" rowspan="1" colspan="1"><span _ngcontent-yov-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-yov-c3=""><!----><tr _ngcontent-yov-c3=""><!----><td _ngcontent-yov-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-yov-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-yov-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-yov-c3="" style="color: #055274;"> </span></td><td _ngcontent-yov-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-yov-c3="" style="color: #055274;"> </span></td><td _ngcontent-yov-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-yov-