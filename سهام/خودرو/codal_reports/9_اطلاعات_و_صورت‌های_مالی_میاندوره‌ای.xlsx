<!----><app-statement _ngcontent-spg-c0="" _nghost-spg-c1=""><div _ngcontent-spg-c1="" style="direction: rtl;"><!----><div _ngcontent-spg-c1=""><!----><div _ngcontent-spg-c1="" class="sheet-container"><app-sheet _ngcontent-spg-c1="" _nghost-spg-c2=""><!----><div _ngcontent-spg-c2="" class="table-containet"><!----><div _ngcontent-spg-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان</div><!----><div _ngcontent-spg-c2="" class="table-description ng-binding ng-scope">کليه مبالغ به ميليون ريال است</div><app-table _ngcontent-spg-c2="" _nghost-spg-c3=""><table _ngcontent-spg-c3="" class="rayanDynamicStatement"><thead _ngcontent-spg-c3=""><!----><tr _ngcontent-spg-c3=""><!----><th _ngcontent-spg-c3="" rowspan="2" colspan="1"><span _ngcontent-spg-c3="">شرح</span></th><th _ngcontent-spg-c3="" rowspan="1" colspan="1"><span _ngcontent-spg-c3="">دوره منتهي به ۱۴۰۵/۰۳/۳۱</span></th><th _ngcontent-spg-c3="" rowspan="1" colspan="1"><span _ngcontent-spg-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۴/۰۳/۳۱</span></th><th _ngcontent-spg-c3="" rowspan="1" colspan="1"><span _ngcontent-spg-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۴/۱۲/۲۹</span></th><th _ngcontent-spg-c3="" rowspan="2" colspan="1"><span _ngcontent-spg-c3="">درصد تغيير</span></th></tr><tr _ngcontent-spg-c3=""><!----><th _ngcontent-spg-c3="" rowspan="1" colspan="1"><span _ngcontent-spg-c3="">حسابرسی نشده</span></th><th _ngcontent-spg-c3="" rowspan="1" colspan="1"><span _ngcontent-spg-c3="">حسابرسی نشده</span></th><th _ngcontent-spg-c3="" rowspan="1" colspan="1"><span _ngcontent-spg-c3="">حسابرسی نشده</span></th></tr></thead><tbody _ngcontent-spg-c3=""><!----><tr _ngcontent-spg-c3=""><!----><td _ngcontent-spg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-spg-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-spg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-spg-c3="" style="color: #055274;"> </span></td><td _ngcontent-spg-c3